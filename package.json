{
  "name": "shinsen-arsenal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "data": "python script/build_shinsen_data.py",
    "data:check": "python script/check_shinsen_data.py",
    "dev": "vite",
    "build": "npm run data:check && npm run typecheck && vite build && node script/build_worker.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:python": "python -m pytest tests/python",
    "test:e2e": "playwright test",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "crawl": "python script/crawl_heroes.py --detail",
    "verify": "npm run data:check && npm run typecheck && npm test && npm run test:python && npm run build"
  },
  "dependencies": {
    "dexie": "^4.2.0",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "esbuild": "^0.28.1",
    "fake-indexeddb": "^6.2.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.5"
  }
}
