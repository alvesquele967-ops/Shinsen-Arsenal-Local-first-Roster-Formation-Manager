# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build
dist/
dist-ssr/
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs
*.njsproj
*.sln
*.sw?

# Old versions
archive/

# Python
__pycache__/
*.py[cod]
.venv/
.coverage

# Build intermediates
.build/

# Data (raw and cache are regenerated by the public crawler)
data/*
!data/.cfg_history/
!data/.cfg_history/*.json.gz

# cache, settings, ai-related
.cache/
.claude/
.pytest_cache/
ai-doc/
.playwright-mcp/
playwright-report/
test-results/
coverage/
devserver*.log

# Secrets — catch all env variants (.env, .env.dev, .env.local, …) but
# keep .env.example checked in as documentation of expected vars.
.env
.env.*
!.env.example
